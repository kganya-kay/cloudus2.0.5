# Copy to .env and fill from Vercel → cloudus2-0-5 → Settings → Environment Variables.
# Do not commit .env.

AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Neon / Vercel Postgres connection string. Localhost only works if Postgres is running.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Social drops use public oEmbed, RSS, and Open Graph. No platform API keys required.

PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
OPENAI_API_KEY=""
